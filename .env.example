# Configuração local, sem credenciais. Copie para .env se precisar alterar.
HOST=127.0.0.1
PORT=3000
# db:local inicia replica set agroLocal nesta porta; o driver o descobre.
# MongoDB standalone NÃO permite as operações comerciais deste incremento.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=agro_mais_brasil
# Adaptador de identidade APENAS para demonstração local, sem contas reais.
DEMO_AUTH_ENABLED=true
# Download oficial de um binário MongoDB apenas para dev/testes.
MONGOMS_VERSION=8.0.16
# Opcional: somente backend. Não colocar chave em --dart-define ou assets Flutter.
WEATHER_ENABLED=false
OPENWEATHER_API_KEY=
